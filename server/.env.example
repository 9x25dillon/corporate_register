# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8787
LOG_LEVEL=info
# Bearer token for POST routes. Required (≥24 chars) when NODE_ENV=production.
API_TOKEN=

# ── Persistence ───────────────────────────────────────────────────────────────
# Unset → in-memory store (state lost on restart; What Changed? forgets).
# docker compose up -d postgres  gives you this URL:
DATABASE_URL=postgres://docket:docket@localhost:5432/docket
DATABASE_POOL_MAX=10

# ── Ingestion ─────────────────────────────────────────────────────────────────
HTTP_USER_AGENT=Docket/0.2 (legal-change monitor)
HTTP_TIMEOUT_MS=20000
# Background worker cadence in minutes; 0 = only on POST /v1/ingest or `npm run ingest`.
INGEST_INTERVAL_MINUTES=0

# Congress.gov (https://api.congress.gov/sign-up/). Sent as X-Api-Key header, never in URLs.
CONGRESS_API_KEY=
CONGRESS_LIMIT=50
# Comma-separated, case-insensitive substrings matched against bill titles. Empty → built-in list.
CONGRESS_KEYWORDS=

# SEC EDGAR. A descriptive User-Agent with contact details is required by SEC fair-access policy.
SEC_USER_AGENT=Docket/0.2 you@example.com
SEC_CIKS=0000320193,0000789019
SEC_FORMS=8-K,10-K,10-Q,S-4,425,DEFM14A,SC TO-T,SC 14D9,SC 13D,SCHEDULE 13D

# RSS / Atom feeds (comma-separated).
FTC_FEEDS=https://www.ftc.gov/feeds/press-release-competition.xml
# Antitrust Division press-release / civil / criminal case-filing feeds; copy the URLs from
# the Division's RSS page. Left empty by default because they could not be verified at build time.
DOJ_FEEDS=

# ── Speech ────────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v4
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Use /with-timestamps to align every script segment to audio time.
ELEVENLABS_TIMESTAMPS=true
# Per-request character ceiling; scripts are split at item boundaries below this.
ELEVENLABS_MAX_CHARS=3000
# Optional voice settings; unset fields are not sent. Higher stability → steadier delivery.
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=
ELEVENLABS_STYLE=
ELEVENLABS_SPEED=
AUDIO_DIR=./data/audio
